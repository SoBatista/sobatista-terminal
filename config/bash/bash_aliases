# Discoverable help ------------------------------------------------------
cmdhelp() {
    local name=${1:-} kind
    if [[ -z $name ]] && command -v fzf >/dev/null 2>&1; then
        name=$(compgen -c | sort -u \
            | fzf --prompt='Command help > ' --height=60% --border=rounded) || return
    fi
    [[ -n $name ]] || {
        printf 'Usage: cmdhelp COMMAND\n' >&2
        return 2
    }

    printf 'Resolution:\n'
    type -a "$name" 2>/dev/null || {
        printf 'Unknown command: %s\n' "$name" >&2
        return 127
    }
    printf '\n'
    kind=$(type -t "$name")
    case $kind in
        alias) alias "$name" ;;
        function) declare -f "$name" ;;
        builtin | keyword) help "$name" ;;
        file)
            if command -v tldr >/dev/null 2>&1 && tldr "$name"; then
                :
            elif command -v man >/dev/null 2>&1 && man -w "$name" >/dev/null 2>&1; then
                man "$name"
            else
                "$name" --help
            fi
            ;;
    esac
}

termhelp() {
    local topic=${1:-menu}
    if [[ $topic == menu ]]; then
        if command -v fzf >/dev/null 2>&1; then
            topic=$(printf '%s\n' \
                'keys - Bash and Terminator shortcuts' \
                'ai - direct Ollama and cloud/local Codex' \
                'git - safe Git shortcuts' \
                'shell - navigation, files, development, and administration' \
                'updates - explicit update boundaries' \
                'security - authorized-testing helpers' \
                'discovery - command documentation tools' \
                | fzf --prompt='Help topic > ' --height=60% --border=rounded) || return
            topic=${topic%% *}
        else
            printf 'Usage: termhelp {keys|ai|git|shell|updates|security|discovery}\n'
            return 0
        fi
    fi

    case $topic in
        keys)
            cat <<'EOF'
BASH / READLINE
  Ctrl-R             search history       Alt-.             previous last argument
  Ctrl-A / Ctrl-E    start/end of line    Ctrl-W            delete previous word
  Ctrl-U / Ctrl-K    delete left/right    Ctrl-X Ctrl-E     edit in $EDITOR
  Up / Down          prefix history       cd -              previous directory

TERMINATOR
  Ctrl-Shift-O/E     split horizontal/vertical
  Ctrl-Tab           cycle terminals      Ctrl-Shift-T/W    new tab/close pane
  Ctrl-Shift-Arrows  resize pane          Ctrl-Shift-X      maximise pane
  Ctrl-PgUp/PgDn     switch tabs          Ctrl-Shift-F      search scrollback
EOF
            ;;
        ai)
            printf 'SELECTED LOCAL MODEL: %s\n' "$LOCAL_LLM_MODEL"
            cat <<'EOF'
DIRECT OLLAMA (local)
  llm_check              diagnose CLI, service, API, models, and selection
  qm / qmodel [MODEL]    fuzzy-select or explicitly persist a model
  q7 / q14 / q30         persist one of the supported defaults
  qmodels / qps          list installed models / loaded models
  q [PROMPT]             chat with the selected model; accepts pipes
  qrun MODEL [PROMPT]    one-off run without changing the selection
  qfile / qdiff          analyze a file / unstaged Git diff
  qstaged / qcommit      review staged changes / propose a commit message
  qlog / qcmd            analyze logs / run and explain a command
  qstop / qstopall       unload the selected model / every loaded model

CLOUD CODEX
  cx / cxask             interactive / non-interactive cloud Codex
  cxr / cxer             resume interactive / non-interactive cloud work
  cxd                    Codex diagnostics

LOCAL CODEX HARNESS + OLLAMA
  cxl / cxlask           interactive / non-interactive local Codex
  cxlr                   resume with the selected local Ollama model
EOF
            ;;
        git)
            cat <<'EOF'
  gst status       ga/gap/gaa add       gc/gcm/gca commit       gd/gds diff
  gl log graph     gb/gba branch        gsw/gsc switch          gr/grs restore
  gf fetch/prune   gp push              gpf force-with-lease    gup ff-only pull
  gw worktree      gwl list worktrees   gwa add worktree
EOF
            ;;
        shell)
            cat <<'EOF'
  .. ... .... -        navigation       mkcd / croot / backup   file helpers
  ll / lt / lsize      listings         diskfree / meminfo      system capacity
  pathlines / dirsize  PATH and sizes   venv / serve            local development
  serve_lan            explicit LAN     dc* / d*                Docker Compose
  ports / routes       networking       services / failed       systemd state
  jboot / jfollow      journal          topcpu / topmem         process views
  pkg_search/install   packages         workbench               three-pane layout
EOF
            ;;
        updates)
            cat <<'EOF'
  system_update      apt, DNF/DNF5, or pacman packages
  apps_update        Flatpak, Snap, pipx, and tldr when installed
  updateall          both groups followed by restartcheck
  updatecodex        inspect and run the official Codex installer
  updateollama       inspect and run the official Ollama installer
  updatestarship     inspect and run the official Starship installer
  qmodels_update     confirm, then update every installed Ollama model
  restartcheck       report distribution reboot hints

Not covered: AppImages, arbitrary source checkouts, every language toolchain,
browser extensions, or all manually installed software. Linux filesystem cache
is normally beneficial and automatically reclaimed; this project never drops it.
EOF
            ;;
        security)
            cat <<'EOF'
AUTHORIZED TARGETS ONLY
  headers URL           response headers
  redirects URL         redirect chain
  dns / dns_short NAME  DNS answers
  certinfo HOST [PORT]  TLS certificate details
  nmap_services TARGET  default scripts and service versions
  nmap_all_tcp TARGET   all TCP ports with an explicit privileged SYN scan
  burp_on/off/status    Burp loopback proxy environment control
EOF
            ;;
        discovery | discover)
            cat <<'EOF'
  cmdhelp [COMMAND]  fuzzy-select or inspect a command, alias, function, or builtin
  type -a COMMAND    show exactly what Bash resolves
  help BUILTIN       Bash builtin documentation
  tldr COMMAND       practical examples
  man COMMAND        full manual
  apropos KEYWORD    search manual descriptions
  alias              list aliases
  declare -F         list functions
EOF
            ;;
        *)
            printf 'Unknown topic: %s\nUsage: termhelp {keys|ai|git|shell|updates|security|discovery}\n' \
                "$topic" >&2
            return 2
            ;;
    esac
}

alias th='termhelp'
alias ch='cmdhelp'
