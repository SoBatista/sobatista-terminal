mkcd() {
    [[ $# -eq 1 ]] || {
        printf 'Usage: mkcd DIRECTORY\n' >&2
        return 2
    }
    mkdir -p -- "$1" && cd -- "$1" || return
}

croot() {
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        printf 'Not inside a Git repository.\n' >&2
        return 1
    }
    cd -- "$root" || return
}

backup() {
    [[ $# -eq 1 ]] || {
        printf 'Usage: backup FILE_OR_DIRECTORY\n' >&2
        return 2
    }
    [[ -e $1 ]] || {
        printf 'Not found: %s\n' "$1" >&2
        return 1
    }
    local destination
    destination="$1.bak.$(date +%Y%m%d-%H%M%S)"
    cp -a -- "$1" "$destination" && printf 'Backup: %s\n' "$destination"
}

