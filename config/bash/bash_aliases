# Local Qwen through Ollama ----------------------------------------------
export LOCAL_LLM_MODEL_STATE="${XDG_CONFIG_HOME:-$HOME/.config}/sobatista-terminal/model"
export LOCAL_LLM_MODEL_DEFAULT='qwen2.5-coder:7b'

_sb_valid_model_name() {
    [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*$ ]]
}

if [[ -r $LOCAL_LLM_MODEL_STATE ]]; then
    IFS= read -r _sb_saved_model <"$LOCAL_LLM_MODEL_STATE"
    if _sb_valid_model_name "$_sb_saved_model"; then
        LOCAL_LLM_MODEL=$_sb_saved_model
    else
        printf 'Ignoring invalid model selection in %s.\n' "$LOCAL_LLM_MODEL_STATE" >&2
    fi
    unset _sb_saved_model
fi
export LOCAL_LLM_MODEL="${LOCAL_LLM_MODEL:-$LOCAL_LLM_MODEL_DEFAULT}"

_sb_require_ollama() {
    command -v ollama >/dev/null 2>&1 || {
        printf 'Ollama is not installed or not in PATH. Run: llm_check\n' >&2
        return 127
    }
}

_sb_installed_models() {
    local output
    output=$(command ollama list 2>&1) || {
        printf 'Unable to list Ollama models. Run: llm_check\n' >&2
        return 1
    }
    awk 'NR > 1 && NF {print $1}' <<<"$output"
}

_sb_model_installed() {
    _sb_installed_models | grep -Fxq -- "$1"
}

_sb_require_selected_model() {
    _sb_model_installed "$LOCAL_LLM_MODEL" || {
        printf 'Selected model is not installed or Ollama is unavailable: %s\n' \
            "$LOCAL_LLM_MODEL" >&2
        printf 'Run llm_check, then select an installed model with qm.\n' >&2
        return 1
    }
}

_sb_ollama_run() {
    local model=$1
    shift
    if [[ -t 0 ]]; then
        if (($#)); then
            command ollama run "$model" "$*"
        else
            command ollama run "$model"
        fi
    elif (($#)); then
        {
            printf 'Instruction:\n%s\n\nInput:\n' "$*"
            cat
        } | command ollama run "$model"
    else
        command ollama run "$model"
    fi
}

llm_check() {
    if ! command -v ollama >/dev/null 2>&1; then
        printf 'Ollama CLI: missing\n' >&2
        printf 'Install it from https://ollama.com/download, then rerun this check.\n' >&2
        return 127
    fi

    printf 'Ollama CLI: '
    command ollama --version || return

    if command -v systemctl >/dev/null 2>&1 \
        && systemctl is-active --quiet ollama 2>/dev/null; then
        printf 'Service: active\n'
    elif pgrep -x ollama >/dev/null 2>&1; then
        printf 'Process: running outside an active system service\n'
    else
        printf 'Service: not detected; start it with systemctl or ollama serve.\n'
    fi

    if command -v curl >/dev/null 2>&1 \
        && curl -fsS --max-time 3 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
        printf 'API: responding on loopback\n'
    else
        printf 'API: not responding on loopback port 11434\n'
    fi

    printf '\nInstalled models:\n'
    command ollama list || return
    printf '\nLoaded models:\n'
    command ollama ps || true
    printf '\nSelected model: %s\n' "$LOCAL_LLM_MODEL"

    if _sb_model_installed "$LOCAL_LLM_MODEL"; then
        printf 'Selection: installed\n'
    else
        printf 'Selection: missing; install explicitly with: ollama pull %s\n' \
            "$LOCAL_LLM_MODEL" >&2
        return 1
    fi
}

qmodels() {
    _sb_require_ollama || return
    command ollama list || return
    printf '\nSelected model: %s\nState file: %s\n' \
        "$LOCAL_LLM_MODEL" "$LOCAL_LLM_MODEL_STATE"
}

qmodel() {
    _sb_require_ollama || return
    local selected=${1:-}

    if [[ -z $selected ]]; then
        if command -v fzf >/dev/null 2>&1; then
            selected=$(_sb_installed_models \
                | fzf --prompt='Local model > ' --height=50% --border=rounded) || return
            [[ -n $selected ]] || return 1
        else
            command ollama list
            printf 'fzf is unavailable. Select explicitly with: qmodel MODEL\n' >&2
            return 2
        fi
    fi

    _sb_valid_model_name "$selected" || {
        printf 'Invalid model name: %s\n' "$selected" >&2
        return 2
    }
    _sb_model_installed "$selected" || {
        printf 'Model is not installed: %s\nInstall it with: ollama pull %s\n' \
            "$selected" "$selected" >&2
        return 1
    }

    local state_dir state_tmp
    state_dir=${LOCAL_LLM_MODEL_STATE%/*}
    mkdir -p -- "$state_dir" || return
    chmod 700 "$state_dir" || return
    state_tmp=$(mktemp "$state_dir/.model.XXXXXXXX") || return
    if ! chmod 600 "$state_tmp" || ! printf '%s\n' "$selected" >"$state_tmp" \
        || ! mv -f -- "$state_tmp" "$LOCAL_LLM_MODEL_STATE"; then
        rm -f -- "$state_tmp"
        return 1
    fi
    LOCAL_LLM_MODEL=$selected
    export LOCAL_LLM_MODEL
    printf 'Local model selected: %s\n' "$LOCAL_LLM_MODEL"
}

qm() {
    qmodel "$@"
}

q7() {
    qmodel qwen2.5-coder:7b
}

q14() {
