qrun() {
    [[ $# -ge 1 ]] || {
        printf 'Usage: qrun MODEL [PROMPT]\n' >&2
        return 2
    }
    _sb_require_ollama || return
    local model=$1
    shift
    _sb_valid_model_name "$model" || {
        printf 'Invalid model name: %s\n' "$model" >&2
        return 2
    }
    _sb_model_installed "$model" || {
        printf 'Model is not installed or Ollama is unavailable: %s\n' "$model" >&2
        printf 'Install it explicitly with: ollama pull %s\n' "$model" >&2
        return 1
    }
    _sb_ollama_run "$model" "$@"
}

q() {
    _sb_require_ollama || return
    _sb_require_selected_model || return
    _sb_ollama_run "$LOCAL_LLM_MODEL" "$@"
}

qfile() {
    [[ -f ${1:-} ]] || {
        printf 'Usage: qfile FILE [QUESTION]\n' >&2
        return 2
    }
    local file=$1
    shift
    {
        printf 'File: %s\nInstruction: %s\n\n' \
            "$file" "${*:-Explain this file, identify risks, and suggest improvements.}"
        cat -- "$file"
    } | q
}

qdiff() {
    local diff
    diff=$(git diff --no-ext-diff -- "$@") || return
    [[ -n $diff ]] || {
        printf 'No unstaged changes.\n'
        return 0
    }
    printf '%s\n' "$diff" \
        | q 'Review this diff. Prioritize correctness, security, regressions, and missing tests.'
}

qstaged() {
    local diff
    diff=$(git diff --cached --no-ext-diff -- "$@") || return
    [[ -n $diff ]] || {
        printf 'No staged changes.\n'
        return 0
    }
    printf '%s\n' "$diff" \
        | q 'Review this staged diff. Prioritize correctness, security, regressions, and missing tests.'
}

qcommit() {
    local diff
    diff=$(git diff --cached --no-ext-diff) || return
    [[ -n $diff ]] || {
        printf 'Nothing is staged.\n' >&2
        return 1
    }
    printf '%s\n' "$diff" \
        | q 'Write one concise Conventional Commit message. Return only the commit message.'
}

qlog() {
    [[ -f ${1:-} ]] || {
        printf 'Usage: qlog LOGFILE [LINES]\n' >&2
        return 2
    }
    local lines=${2:-200}
    [[ $lines =~ ^[1-9][0-9]*$ ]] || {
        printf 'LINES must be a positive integer.\n' >&2
        return 2
    }
    tail -n "$lines" -- "$1" \
        | q 'Triage this log. Identify the likely root cause, evidence, and next three checks.'
}

qcmd() {
    (($#)) || {
        printf 'Usage: qcmd COMMAND [ARG ...]\n' >&2
        return 2
    }
    local tmp status rendered
    tmp=$(mktemp) || return
    printf -v rendered '%q ' "$@"

    "$@" 2>&1 | tee "$tmp"
    status=${PIPESTATUS[0]}
    tail -n 400 -- "$tmp" \
        | q "Command: $rendered Exit status: $status. Explain the result and next concrete action."
    rm -f -- "$tmp"
    return "$status"
}

