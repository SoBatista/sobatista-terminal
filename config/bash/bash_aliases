pkg_search() {
    (($#)) || {
        printf 'Usage: pkg_search QUERY\n' >&2
        return 2
    }
    if command -v apt-cache >/dev/null 2>&1; then
        apt-cache search -- "$*"
    elif command -v dnf5 >/dev/null 2>&1; then
        dnf5 search "$*"
    elif command -v dnf >/dev/null 2>&1; then
        dnf search "$*"
    elif command -v pacman >/dev/null 2>&1; then
        pacman -Ss -- "$*"
    else
        printf 'Supported package manager not found.\n' >&2
        return 127
    fi
}

pkg_install() {
    (($#)) || {
        printf 'Usage: pkg_install PACKAGE...\n' >&2
        return 2
    }
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get install -- "$@"
    elif command -v dnf5 >/dev/null 2>&1; then
        sudo dnf5 install "$@"
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf install "$@"
    elif command -v pacman >/dev/null 2>&1; then
        sudo pacman -S --needed -- "$@"
    else
        printf 'Supported package manager not found.\n' >&2
        return 127
    fi
}

system_update() {
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update && sudo apt-get upgrade
    elif command -v dnf5 >/dev/null 2>&1; then
        sudo dnf5 upgrade --refresh
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf upgrade --refresh
    elif command -v pacman >/dev/null 2>&1; then
        sudo pacman -Syu
    else
        printf 'Supported package manager not found (apt, DNF/DNF5, or pacman).\n' >&2
        return 127
    fi
}

apps_update() {
    local status=0 found=0

    if command -v flatpak >/dev/null 2>&1; then
        found=1
        flatpak update || status=1
    fi
    if command -v snap >/dev/null 2>&1; then
        found=1
        sudo snap refresh || status=1
    fi
    if command -v pipx >/dev/null 2>&1; then
        found=1
        pipx upgrade-all || status=1
    fi
    if command -v tldr >/dev/null 2>&1; then
        found=1
        tldr --update || status=1
    fi

    ((found)) || printf 'No supported optional app ecosystems are installed.\n'
    return "$status"
}

restartcheck() {
    if [[ -e /var/run/reboot-required ]]; then
        printf 'REBOOT RECOMMENDED'
        [[ -s /var/run/reboot-required ]] && printf ': %s' "$(</var/run/reboot-required)"
        printf '\n'
        [[ -r /var/run/reboot-required.pkgs ]] \
            && sed 's/^/  - /' /var/run/reboot-required.pkgs
        return 1
    fi

    if command -v dnf5 >/dev/null 2>&1 \
        && dnf5 needs-restarting --help >/dev/null 2>&1; then
        # --reboothint reports only core (kernel/systemd/glibc) reboots and is
        # not present on every dnf5 build; fall back to plain needs-restarting.
        if dnf5 needs-restarting --help 2>/dev/null | grep -q -- '--reboothint'; then
            if dnf5 needs-restarting --reboothint; then
                printf 'No Fedora reboot hint is active.\n'
                return 0
            fi
            return 1
        fi
        if dnf5 needs-restarting; then
            printf 'No dnf5 restart requirement is active.\n'
            return 0
        fi
        return 1
    fi

    if command -v needs-restarting >/dev/null 2>&1; then
        needs-restarting -r
        return
    fi

    if command -v needrestart >/dev/null 2>&1; then
        sudo needrestart -b
        return
    fi

    printf 'No reboot marker detected. Reboot after kernel, systemd, libc, or GPU-driver updates.\n'
}

updateall() {
    system_update || return
    apps_update || printf 'One optional app ecosystem reported an update error.\n' >&2
    printf '\nNot updated automatically: AppImages, arbitrary source checkouts, every language\n'
    printf 'toolchain, browser extensions, or manually installed software. Use the explicit\n'
    printf 'Codex, Ollama, Starship, and model update helpers when needed.\n'
    restartcheck || true
}

_sb_update_from_installer() {
    [[ $# -ge 2 ]] || return 2
    local name=$1 url=$2
    shift 2
    local installer answer status

    command -v curl >/dev/null 2>&1 || {
        printf 'curl is required to download %s.\n' "$name" >&2
        return 127
    }
    installer=$(mktemp) || return
    if ! curl -fL --retry 3 --connect-timeout 15 -o "$installer" "$url"; then
        rm -f -- "$installer"
        return 1
    fi

    printf '%s installer downloaded from:\n  %s\n' "$name" "$url"
    if command -v sha256sum >/dev/null 2>&1; then
        printf 'SHA-256: %s\n' "$(sha256sum "$installer" | awk '{print $1}')"
    fi
    printf 'Review before execution in another terminal with: less %q\n' "$installer"
    printf 'Run this downloaded installer now? [y/N] '
    IFS= read -r answer
    if [[ $answer != [yY] && $answer != [yY][eE][sS] ]]; then
        printf 'Update cancelled; no installer was executed.\n'
        rm -f -- "$installer"
        return 0
    fi

    sh "$installer" "$@"
    status=$?
    rm -f -- "$installer"
    return "$status"
}

updateollama() {
    _sb_update_from_installer Ollama https://ollama.com/install.sh
}

updatecodex() {
    _sb_update_from_installer Codex https://chatgpt.com/codex/install.sh
}

updatestarship() {
    _sb_update_from_installer Starship https://starship.rs/install.sh \
        -b "$HOME/.local/bin" -y
}

qmodels_update() {
    _sb_require_ollama || return
    local answer model status=0 found=0
    printf 'This can download many gigabytes. Update every installed Ollama model? [y/N] '
    IFS= read -r answer
    [[ $answer == [yY] || $answer == [yY][eE][sS] ]] || return 0

    while IFS= read -r model; do
        [[ -n $model ]] || continue
        found=1
        command ollama pull "$model" || status=1
    done < <(_sb_installed_models)
    ((found)) || printf 'No installed Ollama models found.\n'
    return "$status"
}

